; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="AGI"
run/main_scene="uid://duf7dvpij16me"
config/use_custom_user_dir=true
config/custom_user_dir_name="agi"
config/features=PackedStringArray("4.6", "C#", "Forward Plus")
run/max_fps=60
run/low_processor_mode=true
boot_splash/bg_color=Color(1, 1, 1, 1)
boot_splash/stretch_mode=0
boot_splash/image="uid://dxui8em8fu8w3"
config/icon="uid://dxui8em8fu8w3"

[audio]

buses/default_bus_layout="uid://b8m7idityqok1"
driver/enable_input=true

[autoload]

NetworkManager="*uid://dd0kvqdfb8yt5"
ChatManager="*uid://dkwmatdh8pqge"
BackendLauncher="*uid://d2ggr6q7smtv6"
EnvironmentManager="*uid://cs671kefxiink"
PackageManager="*uid://byupl1skovdap"
DownloadManager="*uid://cqsbifwhnnad8"
ConfigManager="*uid://r3isoxio4wpf"
ThemeManager="*uid://cyfyr5s4khbg4"
NotificationManager="*uid://bvpfm0psskjmy"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/size/transparent=true
window/energy_saving/keep_screen_on=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/per_pixel_transparency/allowed=true

[dotnet]

project/assembly_name="AGI"

[editor_plugins]

enabled=PackedStringArray("res://addons/TextContainer/plugin.cfg")

[gui]

theme/custom_font="uid://p86vubqfskj0"

[physics]

2d/run_on_separate_thread=true
2d/physics_engine="GodotPhysics2D"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/use_physical_light_units=true
viewport/hdr_2d=true
